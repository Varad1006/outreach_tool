# Copy this file to .env and fill it in. Never share or commit .env.

# --- Claude (AI drafting + lead research) -------------------------------
# Get a key at https://console.anthropic.com/  → API keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Sending (SMTP) -------------------------------------------------------
# Google Workspace / Gmail: smtp.gmail.com, port 587, and an App Password
#   (Google Account → Security → 2-Step Verification → App passwords).
# Zoho: smtp.zoho.com 587 · Outlook/M365: smtp.office365.com 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=
FROM_EMAIL=you@yourdomain.com
# REPLY_TO=

# --- Reply / bounce tracking (IMAP) --------------------------------------
# Defaults to the SMTP user/password. Gmail: imap.gmail.com (enable IMAP in Gmail settings)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=

# --- App ------------------------------------------------------------------
# HOST=127.0.0.1
# PORT=5050
# Set a password if you deploy this anywhere public (needed for open tracking):
# APP_PASSWORD=
# FLASK_SECRET=any-long-random-string
